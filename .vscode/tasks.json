{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Launch Development Server",
      "type": "shell",
      "command": "bun",
      "args": ["run", "dev"],
      "presentation": {
        "panel": "shared"
      },
      "options": {
        "cwd": "${workspaceRoot}"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Build Library",
      "type": "shell",
      "command": "bun",
      "args": ["run", "build"],
      "presentation": {
        "panel": "shared"
      },
      "options": {
        "cwd": "${workspaceRoot}"
      },
      "problemMatcher": ["$tsc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "bun",
      "args": ["run", "test"],
      "presentation": {
        "panel": "shared"
      },
      "options": {
        "cwd": "${workspaceRoot}"
      },
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
