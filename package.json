{
  "name": "react-smoothie",
  "version": "1.0.0",
  "description": "React wrapper for Smoothie Charts",
  "author": "Cameron Tacklind <cameron@tacklind.com>",
  "homepage": "https://github.com/cinderblock/react-smoothie#readme",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/cinderblock/react-smoothie/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cinderblock/react-smoothie.git"
  },
  "keywords": [
    "smoothie",
    "chart",
    "streaming",
    "live",
    "realtime",
    "jsx",
    "tsx",
    "react"
  ],
  "main": "dist/cjs/SmoothieComponent.js",
  "module": "dist/esm/SmoothieComponent.js",
  "types": "dist/cjs/SmoothieComponent.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/SmoothieComponent.d.ts",
        "default": "./dist/esm/SmoothieComponent.js"
      },
      "require": {
        "types": "./dist/cjs/SmoothieComponent.d.ts",
        "default": "./dist/cjs/SmoothieComponent.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "examples/SmoothieDemo.tsx"
  ],
  "scripts": {
    "setup": "install-vscode-extensions",
    "dev": "bun --port 3456 examples/index.html",
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node scripts/write-dist-package-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "npm run build"
  },
  "dependencies": {
    "smoothie": "^1.36.1"
  },
  "peerDependencies": {
    "react": ">=16.8"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "install-vscode-extensions": "1.0.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  }
}
